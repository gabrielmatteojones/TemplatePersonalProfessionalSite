---
layout: null
search: false
---
{% assign voci = site.pages | where_exp: "p", "p.title and p.search != false" | concat: site.posts | concat: site.progetti -%}
[
{%- for v in voci %}
  { "titolo": {{ v.title | jsonify }}, "url": {{ v.url | relative_url | jsonify }}, "testo": {{ v.content | strip_html | strip_newlines | truncate: 400 | jsonify }} }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
